{
  "name": "agentic-large-language-models",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "docs:check": "node scripts/validate-site-source.mjs",
    "docs:generate": "node scripts/generate-site.mjs",
    "docs:dev": "pnpm docs:check && pnpm docs:generate && vitepress dev site",
    "docs:build": "pnpm docs:check && pnpm docs:generate && vitepress build site",
